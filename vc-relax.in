&CONTROL
  calculation    = 'vc-relax',
  prefix         = 'ZrO2_Na3LaCl6',
  restart_mode   = 'from_scratch',

  pseudo_dir     = '/home/ryogasyailendra/pseudo/',
  outdir         = './output/',

  verbosity      = 'high',

  tstress        = .true.,
  tprnfor        = .true.,

  forc_conv_thr  = 1.0d-4
/


&SYSTEM
  ibrav          = 0,

  nat            = 64,
  ntyp           = 5,

  ecutwfc        = 60,
  ecutrho        = 480,

  occupations    = 'smearing',
  smearing       = 'mp',
  degauss        = 0.02,

  vdw_corr       = 'grimme-d3'
/


&ELECTRONS
  conv_thr         = 1.0d-8,
  electron_maxstep = 200,

  mixing_mode      = 'local-TF',
  mixing_beta      = 0.2
/


&IONS
  ion_dynamics = 'bfgs'
/


&CELL
  cell_dofree = '2Dxy',
  cell_factor = 2.0D0
/


